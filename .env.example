# ═══════════════════════════════════════════════════════════
# CatalogPro - Configuracao de Ambiente
# ═══════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/catalogpro

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# ─── Storage (Cloudflare R2) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── API ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://catalogpro.pages.dev

# ─── Frontend ──────────────────────────────────────────────
# URL base da API (usada pelo Vite no frontend)
VITE_API_URL=http://localhost:3001
